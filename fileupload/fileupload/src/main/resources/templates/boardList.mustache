<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <title>Board List</title>
  <style>
    * {
      box-sizing: border-box;
      font-family: 'Apple SD Gothic Neo', 'Segoe UI', sans-serif;
    }

    body {
      background-color: #f5f5f5;
      padding: 50px 20px;
      color: #333;
    }

    h1 {
      text-align: center;
      margin-bottom: 40px;
      font-size: 28px;
      font-weight: 600;
      color: #222;
    }

    .msg {
      text-align: center;
      margin-bottom: 20px;
      font-size: 14px;
      color: #4caf50;
    }

    table {
      width: 100%;
      max-width: 720px;
      margin: 0 auto 40px auto;
      border-collapse: collapse;
      border: 1px solid #ddd;
      background-color: #fff;
      border-radius: 6px;
      overflow: hidden;
    }

    thead {
      background-color: #f0f0f0;
    }

    th, td {
      padding: 14px 18px;
      text-align: left;
      font-size: 15px;
    }

    th {
      color: #555;
      font-weight: 500;
      border-bottom: 1px solid #ddd;
    }

    tr + tr td {
      border-top: 1px solid #f0f0f0;
    }

    tr:hover {
      background-color: #fafafa;
    }

    a {
      color: #333;
      text-decoration: none;
    }

    a:hover {
      text-decoration: underline;
    }

    .add-button {
      display: inline-block;
      padding: 12px 28px;
      margin: 0 auto;
      font-size: 15px;
      background-color: #e0e0e0; /* 밝은 회색 */
      color: #222;
      border: none;
      border-radius: 8px;
      text-decoration: none;
      transition: all 0.3s ease;
      font-weight: 500;
      box-shadow: 0 2px 5px rgba(0,0,0,0.05);
    }

    .add-button:hover {
      background-color: #cccccc; /* 호버 시 약간 더 진한 회색 */
      transform: scale(1.03);
    }

    .button-container {
      text-align: center;
    }
  </style>
</head>
<body>
  <h1>Board List</h1>

  {{#msg}}
    <div class="msg">{{msg}}</div>
  {{/msg}}

  <table>
    <thead>
      <tr>
        <th>No</th>
        <th>제목</th>
      </tr>
    </thead>
    <tbody>
      {{#list}}
        <tr>
          <td>{{bno}}</td>
          <td><a href="/boardOne?bno={{bno}}">{{title}}</a></td>
        </tr>
      {{/list}}
    </tbody>
  </table>
<div class="pagination" style="text-align: center; margin-top: 30px;">
  {{^isFirst}}
    <a href="/boardList?currentPage={{prePage}}" class="btn btn-outline-secondary btn-sm">← 이전</a>
  {{/isFirst}}

  <span class="fw-bold">Page {{currentPage}} / {{totalPages}}</span>

  {{#hasNext}}
    <a href="/boardList?currentPage={{nextPage}}" class="btn btn-outline-secondary btn-sm">다음 →</a>
  {{/hasNext}}
</div>
  <div class="button-container">
    <a class="add-button" href="addBoard">+ 글쓰기</a>
  </div>
</body>
</html>
